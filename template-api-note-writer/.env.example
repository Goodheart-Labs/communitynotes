# X API credentials
X_API_KEY=your_x_api_key_here
X_API_KEY_SECRET=your_x_api_key_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# AI API Keys
# For default Grok mode
XAI_API_KEY=your_xai_api_key_here

# For enhanced research mode with OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_REFERER=https://github.com/yourusername/communitynotes

# Research Configuration
# Options: "grok" (default) or "enhanced"
RESEARCH_MODE=grok

# Enhanced Research Settings
FETCH_TIMEOUT=10  # Timeout in seconds for fetching web pages
MAX_SOURCES_TO_FETCH=5  # Maximum number of sources to fetch content from