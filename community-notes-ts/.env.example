# X API Credentials (from https://developer.twitter.com/)
X_API_KEY=your_x_api_key_here
X_API_KEY_SECRET=your_x_api_key_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Research Configuration
# Options: "grok" or "enhanced" (enhanced uses Perplexity + Claude)
RESEARCH_MODE=enhanced

# Enhanced Research Settings
FETCH_TIMEOUT=10000  # Timeout in milliseconds for fetching web pages
MAX_SOURCES_TO_FETCH=5  # Maximum number of sources to fetch content from